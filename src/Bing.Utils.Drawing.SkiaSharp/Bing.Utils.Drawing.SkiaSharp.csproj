<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<AssemblyName>Bing.Utils.Drawing.SkiaSharp</AssemblyName>
		<PackageId>Bing.Utils.Drawing.SkiaSharp</PackageId>
		<Description>Bing.Utils.Drawing.SkiaSharp是Bing应用框架的图片操作类库。基于 SkiaSharp 封装的类库</Description>
	</PropertyGroup>

	<Import Project="..\..\common.props" />

	<PropertyGroup>
		<Nullable>enable</Nullable>
		<LangVersion>10.0</LangVersion>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Include="..\Bing.Utils.Drawing.Shared\Bing\Drawing\Internal\DrawingCompatibilityHelper.cs" Link="Bing\Drawing\Internal\DrawingCompatibilityHelper.cs" />
	  <Compile Include="..\Bing.Utils.Drawing.Shared\Bing\Drawing\Internal\CaptchaCodeGenerator.cs" Link="Bing\Drawing\Internal\CaptchaCodeGenerator.cs" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="SkiaSharp" Version="2.88.9" />
	</ItemGroup>

</Project>
